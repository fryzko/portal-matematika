---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Analisis Data & Peluang">
  <div class="container mx-auto px-4 py-16 max-w-2xl text-center">
    <div class="bg-cyan-50 border-2 border-cyan-200 rounded-2xl p-10 shadow-sm mt-10">
      <svg viewBox="0 0 100 100" width="120" height="120" fill="none" xmlns="http://www.w3.org/2000/svg" class="mx-auto mb-6">
        <circle cx="30" cy="40" r="20" stroke="#06b6d4" stroke-width="4"/>
        <text x="30" y="45" fill="#06b6d4" font-size="14" font-weight="bold" text-anchor="middle">Rp</text>
        <path d="M40 80 Q 70 20 90 80" stroke="#06b6d4" stroke-width="4" fill="none"/>
      </svg>
      
      <h1 class="text-3xl font-bold mb-4 text-gray-800">Analisis Data & Peluang</h1>
      
      <p class="text-lg text-gray-600 mb-8 max-w-md mx-auto">
        Topik ini telah digabungkan ke dalam halaman <strong>Statistika & Peluang</strong> untuk pengalaman belajar yang lebih terpadu.
      </p>
      
      <a href="/elemen/statistika" class="btn-redirect">
        Lihat Statistika & Peluang
      </a>
    </div>
  </div>
</Layout>

<style>
.btn-redirect {
  display: inline-block;
  padding: 0.8rem 2rem;
  background-color: #06b6d4;
  color: white;
  font-weight: 600;
  font-size: 1.1rem;
  border-radius: 10px;
  text-decoration: none;
  transition: transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 4px 10px rgba(6, 182, 212, 0.3);
}
.btn-redirect:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 15px rgba(6, 182, 212, 0.4);
}
</style>
