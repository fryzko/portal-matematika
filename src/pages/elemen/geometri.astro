---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Geometri">
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="elemen-header">
      <svg viewBox="0 0 100 100" width="100" height="100" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink: 0;">
        <polygon points="30,30 10,70 50,70" stroke="white" stroke-width="4"/>
        <circle cx="75" cy="40" r="15" stroke="white" stroke-width="4"/>
        <rect x="60" y="65" width="25" height="25" fill="white"/>
      </svg>
      <div>
        <h1 class="text-4xl font-bold mb-2">Geometri</h1>
        <p class="text-lg opacity-90">Mempelajari bentuk, ruang, dan hubungan antar bangun</p>
      </div>
    </div>

    <div class="topik-section">
      <h2>Topik dalam Elemen Ini</h2>
      
      <h3 class="font-semibold text-lg mt-6 mb-3">Garis & Sudut</h3>
      <div class="topik-grid">
        <a href="/materi/geometri/garis-dan-sudut/01-mengenal-garis-dan-sudut" class="topik-link">Mengenal Garis dan Sudut</a>
        <a href="/materi/geometri/garis-dan-sudut/02-hubungan-antar-sudut" class="topik-link">Hubungan Antar Sudut</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Segiempat & Segitiga</h3>
      <div class="topik-grid">
        <a href="/materi/geometri/segiempat-segitiga/01-keliling-luas-segitiga" class="topik-link">Keliling & Luas Segitiga</a>
        <a href="/materi/geometri/segiempat-segitiga/02-keliling-luas-segiempat" class="topik-link">Keliling & Luas Segiempat</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Teorema Pythagoras</h3>
      <div class="topik-grid">
        <a href="/materi/geometri/teorema-pythagoras/02-triple-pythagoras" class="topik-link">Triple Pythagoras</a>
        <a href="/materi/geometri/teorema-pythagoras/03-pythagoras-koordinat" class="topik-link">Pythagoras di Bidang Koordinat</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Lingkaran</h3>
      <div class="topik-grid">
        <a href="/materi/geometri/lingkaran/01-keliling-dan-luas-lingkaran" class="topik-link">Keliling & Luas Lingkaran</a>
        <a href="/materi/geometri/lingkaran/02-busur-juring-dan-tali-busur" class="topik-link">Busur, Juring & Tali Busur</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Bangun Ruang</h3>
      <div class="topik-grid">
        <a href="/materi/geometri/bangun-ruang/10-bangun-ruang-dan-jaring-jaring" class="topik-link">Jaring-jaring Bangun Ruang</a>
        <a href="/materi/geometri/bangun-ruang/11-volume-bangun-ruang" class="topik-link">Volume Bangun Ruang</a>
        <a href="/materi/geometri/bangun-ruang/12-luas-permukaan" class="topik-link">Luas Permukaan</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Transformasi & Kesebangunan</h3>
      <div class="topik-grid">
        <a href="/materi/geometri/transformasi/01-translasi" class="topik-link">Translasi</a>
        <a href="/materi/geometri/transformasi/02-refleksi" class="topik-link">Refleksi</a>
        <a href="/materi/geometri/transformasi/03-rotasi" class="topik-link">Rotasi</a>
        <a href="/materi/geometri/transformasi/04-dilatasi" class="topik-link">Dilatasi</a>
        <a href="/materi/geometri/kesebangunan/01-kesebangunan-bangun-datar" class="topik-link">Kesebangunan</a>
        <a href="/materi/geometri/kesebangunan/02-kekongruenan" class="topik-link">Kekongruenan</a>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mt-12">
      <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
        <h3 class="font-bold text-xl mb-4 flex items-center gap-2">
          <span class="text-2xl">🌍</span> Mengapa Belajar Geometri?
        </h3>
        <ul class="space-y-3 text-gray-700">
          <li class="flex gap-2">
            <span class="text-green-500 font-bold">•</span>
            <span><strong>Arsitektur:</strong> Merancang bangunan yang kokoh, estetis, dan presisi.</span>
          </li>
          <li class="flex gap-2">
            <span class="text-green-500 font-bold">•</span>
            <span><strong>Desain Grafis:</strong> Memahami komposisi, simetri, dan transformasi visual.</span>
          </li>
          <li class="flex gap-2">
            <span class="text-green-500 font-bold">•</span>
            <span><strong>Navigasi GPS:</strong> Menggunakan prinsip geometri untuk menentukan lokasi dan rute.</span>
          </li>
        </ul>
      </div>

      <div class="bg-green-50 p-6 rounded-xl border border-green-100">
        <h3 class="font-bold text-xl mb-4 flex items-center gap-2 text-green-800">
          <span class="text-2xl">🚀</span> Mulai dari Mana?
        </h3>
        <p class="mb-4 text-gray-700">Rekomendasi urutan belajar yang terstruktur:</p>
        <ol class="space-y-2 text-green-900 font-medium">
          <li>1. Garis & Sudut</li>
          <li>2. Segiempat & Segitiga</li>
          <li>3. Pythagoras</li>
          <li>4. Lingkaran</li>
          <li>5. Bangun Ruang</li>
          <li>6. Transformasi</li>
        </ol>
      </div>
    </div>
  </div>
</Layout>

<style>
.elemen-header {
  background: linear-gradient(135deg, #10b981 0%, #047857 100%);
  color: white;
  padding: 3rem 2rem;
  border-radius: 16px;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  gap: 2rem;
}
.topik-section {
  margin-bottom: 2rem;
}
.topik-section h2 {
  font-size: 1.3rem;
  font-weight: 700;
  padding-bottom: 0.5rem;
  border-bottom: 3px solid #10b981;
  margin-bottom: 1rem;
}
.topik-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 0.75rem;
}
.topik-link {
  display: block;
  padding: 0.75rem 1rem;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  color: #1e293b;
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s;
  border-left: 4px solid #10b981;
}
.topik-link:hover {
  background: #d1fae5;
  border-color: #10b981;
  transform: translateX(4px);
}
@media (max-width: 768px) {
  .elemen-header {
    flex-direction: column;
    text-align: center;
    padding: 2rem 1.5rem;
  }
}
</style>
