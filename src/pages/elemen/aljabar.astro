---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Aljabar">
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="elemen-header">
      <svg viewBox="0 0 100 100" width="100" height="100" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink: 0;">
        <path d="M50 80 L50 40 M20 40 L80 40 M20 40 L20 60 M80 40 L80 60" stroke="white" stroke-width="4" stroke-linejoin="round"/>
        <path d="M35 80 L65 80" stroke="white" stroke-width="4" stroke-linecap="round"/>
        <rect x="10" y="60" width="20" height="10" fill="white"/>
        <rect x="70" y="50" width="20" height="20" fill="white"/>
        <text x="20" y="55" fill="#8b5cf6" font-size="12" font-weight="bold" text-anchor="middle">x</text>
        <text x="80" y="65" fill="#8b5cf6" font-size="12" font-weight="bold" text-anchor="middle">5</text>
      </svg>
      <div>
        <h1 class="text-4xl font-bold mb-2">Aljabar</h1>
        <p class="text-lg opacity-90">Menggunakan simbol dan variabel untuk memecahkan masalah</p>
      </div>
    </div>

    <div class="topik-section">
      <h2>Topik dalam Elemen Ini</h2>
      
      <h3 class="font-semibold text-lg mt-6 mb-3">Pola Bilangan</h3>
      <div class="topik-grid">
        <a href="/materi/aljabar/pola-bilangan/mengenal-pola-bilangan" class="topik-link">Mengenal Pola Bilangan</a>
        <a href="/materi/aljabar/pola-bilangan/02-pola-bilangan-geometri" class="topik-link">Pola Bilangan Geometri</a>
        <a href="/materi/aljabar/pola-bilangan/03-pola-bilangan-figuratif" class="topik-link">Pola Bilangan Figuratif</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Bentuk Aljabar</h3>
      <div class="topik-grid">
        <a href="/materi/aljabar/bentuk-aljabar/04-unsur-unsur-aljabar" class="topik-link">Unsur-unsur Aljabar</a>
        <a href="/materi/aljabar/bentuk-aljabar/05-operasi-hitung-aljabar" class="topik-link">Operasi Hitung Aljabar</a>
        <a href="/materi/aljabar/bentuk-aljabar/08a-spldv-substitusi" class="topik-link">SPLDV: Metode Substitusi</a>
        <a href="/materi/aljabar/bentuk-aljabar/08b-spldv-eliminasi" class="topik-link">SPLDV: Metode Eliminasi</a>
        <a href="/materi/aljabar/bentuk-aljabar/08c-spldv-grafik" class="topik-link">SPLDV: Metode Grafik</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Persamaan Linear</h3>
      <div class="topik-grid">
        <a href="/materi/aljabar/persamaan-linear/01-persamaan-linear-satu-variabel" class="topik-link">Persamaan Linear Satu Variabel</a>
        <a href="/materi/aljabar/persamaan-linear/02-pertidaksamaan-linear" class="topik-link">Pertidaksamaan Linear</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Relasi & Fungsi</h3>
      <div class="topik-grid">
        <a href="/materi/aljabar/relasi-fungsi/01-mengenal-relasi" class="topik-link">Mengenal Relasi</a>
        <a href="/materi/aljabar/relasi-fungsi/02-mengenal-fungsi" class="topik-link">Mengenal Fungsi</a>
        <a href="/materi/aljabar/relasi-fungsi/03-grafik-fungsi" class="topik-link">Grafik Fungsi</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Persamaan Garis Lurus</h3>
      <div class="topik-grid">
        <a href="/materi/aljabar/persamaan-garis-lurus/01-gradien-garis" class="topik-link">Gradien Garis</a>
        <a href="/materi/aljabar/persamaan-garis-lurus/02-persamaan-garis-lurus" class="topik-link">Persamaan Garis Lurus</a>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mt-12">
      <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
        <h3 class="font-bold text-xl mb-4 flex items-center gap-2">
          <span class="text-2xl">🌍</span> Mengapa Belajar Aljabar?
        </h3>
        <ul class="space-y-3 text-gray-700">
          <li class="flex gap-2">
            <span class="text-purple-500 font-bold">•</span>
            <span><strong>Pemrograman:</strong> Logika aljabar adalah pondasi utama dalam mendefinisikan variabel dan fungsi.</span>
          </li>
          <li class="flex gap-2">
            <span class="text-purple-500 font-bold">•</span>
            <span><strong>Ekonomi:</strong> Memodelkan fungsi harga, penawaran, dan permintaan di pasar.</span>
          </li>
          <li class="flex gap-2">
            <span class="text-purple-500 font-bold">•</span>
            <span><strong>Fisika:</strong> Membaca dan menghitung dari grafik kecepatan, jarak, dan waktu.</span>
          </li>
        </ul>
      </div>

      <div class="bg-purple-50 p-6 rounded-xl border border-purple-100">
        <h3 class="font-bold text-xl mb-4 flex items-center gap-2 text-purple-800">
          <span class="text-2xl">🚀</span> Mulai dari Mana?
        </h3>
        <p class="mb-4 text-gray-700">Rekomendasi urutan belajar yang terstruktur:</p>
        <ol class="space-y-2 text-purple-900 font-medium">
          <li>1. Pola Bilangan</li>
          <li>2. Bentuk Aljabar</li>
          <li>3. Persamaan Linear</li>
          <li>4. Relasi & Fungsi</li>
          <li>5. Persamaan Garis Lurus</li>
          <li>6. SPLDV</li>
        </ol>
      </div>
    </div>
  </div>
</Layout>

<style>
.elemen-header {
  background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
  color: white;
  padding: 3rem 2rem;
  border-radius: 16px;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  gap: 2rem;
}
.topik-section {
  margin-bottom: 2rem;
}
.topik-section h2 {
  font-size: 1.3rem;
  font-weight: 700;
  padding-bottom: 0.5rem;
  border-bottom: 3px solid #8b5cf6;
  margin-bottom: 1rem;
}
.topik-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 0.75rem;
}
.topik-link {
  display: block;
  padding: 0.75rem 1rem;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  color: #1e293b;
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s;
  border-left: 4px solid #8b5cf6;
}
.topik-link:hover {
  background: #f3e8ff;
  border-color: #8b5cf6;
  transform: translateX(4px);
}
@media (max-width: 768px) {
  .elemen-header {
    flex-direction: column;
    text-align: center;
    padding: 2rem 1.5rem;
  }
}
</style>
