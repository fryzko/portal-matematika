---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Elemen Pembelajaran">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-center mb-8">Elemen Pembelajaran</h1>
    <div class="elemen-grid">
      <!-- Kartu 1 -->
      <div class="elemen-card" style="border-bottom-color: #3b82f6;">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="20" y="20" width="60" height="40" rx="4" stroke="#3b82f6" stroke-width="4"/>
          <text x="50" y="48" fill="#3b82f6" font-size="24" font-weight="bold" text-anchor="middle">123</text>
          <line x1="10" y1="80" x2="90" y2="80" stroke="#3b82f6" stroke-width="4" stroke-linecap="round"/>
          <circle cx="30" cy="80" r="4" fill="#3b82f6"/>
          <circle cx="50" cy="80" r="4" fill="#3b82f6"/>
          <circle cx="70" cy="80" r="4" fill="#3b82f6"/>
        </svg>
        <h2 style="color: #3b82f6;">Bilangan</h2>
        <p>Memahami berbagai jenis bilangan dan operasi hitungnya</p>
        <a href="/elemen/bilangan" class="btn-jelajahi" style="background-color: #3b82f6;">Jelajahi &rarr;</a>
      </div>

      <!-- Kartu 2 -->
      <div class="elemen-card" style="border-bottom-color: #8b5cf6;">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M50 80 L50 40 M20 40 L80 40 M20 40 L20 60 M80 40 L80 60" stroke="#8b5cf6" stroke-width="4" stroke-linejoin="round"/>
          <path d="M35 80 L65 80" stroke="#8b5cf6" stroke-width="4" stroke-linecap="round"/>
          <rect x="10" y="60" width="20" height="10" fill="#8b5cf6"/>
          <rect x="70" y="50" width="20" height="20" fill="#8b5cf6"/>
          <text x="20" y="55" fill="white" font-size="12" font-weight="bold" text-anchor="middle">x</text>
          <text x="80" y="65" fill="white" font-size="12" font-weight="bold" text-anchor="middle">5</text>
        </svg>
        <h2 style="color: #8b5cf6;">Aljabar</h2>
        <p>Menggunakan simbol dan variabel untuk memecahkan masalah</p>
        <a href="/elemen/aljabar" class="btn-jelajahi" style="background-color: #8b5cf6;">Jelajahi &rarr;</a>
      </div>

      <!-- Kartu 3 -->
      <div class="elemen-card" style="border-bottom-color: #f59e0b;">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="10" y="30" width="80" height="20" rx="2" stroke="#f59e0b" stroke-width="4"/>
          <line x1="20" y1="30" x2="20" y2="40" stroke="#f59e0b" stroke-width="2"/>
          <line x1="40" y1="30" x2="40" y2="40" stroke="#f59e0b" stroke-width="2"/>
          <line x1="60" y1="30" x2="60" y2="40" stroke="#f59e0b" stroke-width="2"/>
          <line x1="80" y1="30" x2="80" y2="40" stroke="#f59e0b" stroke-width="2"/>
          <path d="M30 80 A 20 20 0 0 1 70 80 Z" fill="#f59e0b"/>
        </svg>
        <h2 style="color: #f59e0b;">Pengukuran</h2>
        <p>Mengukur panjang, sudut, luas, volume, dan satuan</p>
        <a href="/elemen/pengukuran" class="btn-jelajahi" style="background-color: #f59e0b;">Jelajahi &rarr;</a>
      </div>

      <!-- Kartu 4 -->
      <div class="elemen-card" style="border-bottom-color: #10b981;">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="30,30 10,70 50,70" stroke="#10b981" stroke-width="4"/>
          <circle cx="75" cy="40" r="15" stroke="#10b981" stroke-width="4"/>
          <rect x="60" y="65" width="25" height="25" fill="#10b981"/>
        </svg>
        <h2 style="color: #10b981;">Geometri</h2>
        <p>Mempelajari bentuk, ruang, dan hubungan antar bangun</p>
        <a href="/elemen/geometri" class="btn-jelajahi" style="background-color: #10b981;">Jelajahi &rarr;</a>
      </div>

      <!-- Kartu 5 -->
      <div class="elemen-card" style="border-bottom-color: #ef4444;">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="10" y1="90" x2="90" y2="90" stroke="#ef4444" stroke-width="4"/>
          <line x1="10" y1="90" x2="10" y2="10" stroke="#ef4444" stroke-width="4"/>
          <rect x="20" y="50" width="15" height="40" fill="#ef4444"/>
          <rect x="45" y="20" width="15" height="70" fill="#ef4444" opacity="0.8"/>
          <rect x="70" y="65" width="15" height="25" fill="#ef4444" opacity="0.6"/>
        </svg>
        <h2 style="color: #ef4444;">Statistika</h2>
        <p>Mengumpulkan, menyajikan, dan menganalisis data</p>
        <a href="/elemen/statistika" class="btn-jelajahi" style="background-color: #ef4444;">Jelajahi &rarr;</a>
      </div>

      <!-- Kartu 6 -->
      <div class="elemen-card" style="border-bottom-color: #06b6d4;">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="30" cy="40" r="20" stroke="#06b6d4" stroke-width="4"/>
          <text x="30" y="45" fill="#06b6d4" font-size="14" font-weight="bold" text-anchor="middle">Rp</text>
          <path d="M40 80 Q 70 20 90 80" stroke="#06b6d4" stroke-width="4" fill="none"/>
        </svg>
        <h2 style="color: #06b6d4;">Analisis Data & Peluang</h2>
        <p>Memahami kemungkinan dan menganalisis data</p>
        <a href="/elemen/analisis-data-peluang" class="btn-jelajahi" style="background-color: #06b6d4;">Jelajahi &rarr;</a>
      </div>
    </div>
  </div>
</Layout>

<style>
.elemen-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  max-width: 900px;
  margin: 2rem auto;
}
.elemen-card {
  border-radius: 16px;
  padding: 2rem;
  background: white;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  border: 2px solid transparent;
  transition: transform 0.2s, box-shadow 0.2s;
  text-align: center;
}
.elemen-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 30px rgba(0,0,0,0.15);
}
.elemen-card svg {
  width: 120px;
  height: 120px;
  margin: 0 auto 1rem;
  display: block;
}
.elemen-card h2 {
  font-size: 1.5rem;
  margin-bottom: 0.5rem;
}
.elemen-card p {
  color: #64748b;
  margin-bottom: 1.5rem;
  font-size: 0.95rem;
}
.btn-jelajahi {
  display: inline-block;
  padding: 0.6rem 1.5rem;
  border-radius: 8px;
  color: white;
  font-weight: 600;
  text-decoration: none;
  transition: opacity 0.2s;
}
.btn-jelajahi:hover { opacity: 0.85; }
@media (max-width: 768px) {
  .elemen-grid { grid-template-columns: 1fr; }
}
</style>
