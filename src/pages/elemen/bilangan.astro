---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Bilangan">
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="elemen-header">
      <svg viewBox="0 0 100 100" width="100" height="100" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink: 0;">
        <rect x="20" y="20" width="60" height="40" rx="4" stroke="white" stroke-width="4"/>
        <text x="50" y="48" fill="white" font-size="24" font-weight="bold" text-anchor="middle">123</text>
        <line x1="10" y1="80" x2="90" y2="80" stroke="white" stroke-width="4" stroke-linecap="round"/>
        <circle cx="30" cy="80" r="4" fill="white"/>
        <circle cx="50" cy="80" r="4" fill="white"/>
        <circle cx="70" cy="80" r="4" fill="white"/>
      </svg>
      <div>
        <h1 class="text-4xl font-bold mb-2">Bilangan</h1>
        <p class="text-lg opacity-90">Memahami berbagai jenis bilangan dan operasi hitungnya</p>
      </div>
    </div>

    <div class="topik-section">
      <h2>Topik dalam Elemen Ini</h2>
      
      <h3 class="font-semibold text-lg mt-6 mb-3">Bilangan Bulat</h3>
      <div class="topik-grid">
        <a href="/materi/bilangan/bilangan-bulat/01-mengenal-bilangan-bulat" class="topik-link">Mengenal Bilangan Bulat</a>
        <a href="/materi/bilangan/bilangan-bulat/02-membandingkan-mengurutkan" class="topik-link">Membandingkan & Mengurutkan</a>
        <a href="/materi/bilangan/bilangan-bulat/03-operasi-penjumlahan-pengurangan" class="topik-link">Operasi Penjumlahan & Pengurangan</a>
        <a href="/materi/bilangan/bilangan-bulat/04-operasi-perkalian-pembagian" class="topik-link">Operasi Perkalian & Pembagian</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Bilangan Rasional & Pecahan</h3>
      <div class="topik-grid">
        <a href="/materi/bilangan/bilangan-rasional/01-mengenal-bilangan-rasional" class="topik-link">Mengenal Bilangan Rasional</a>
        <a href="/materi/bilangan/bilangan-rasional/02-operasi-dan-estimasi" class="topik-link">Operasi & Estimasi</a>
        <a href="/materi/bilangan/bilangan-rasional/03-literasi-finansial" class="topik-link">Literasi Finansial</a>
        <a href="/materi/bilangan/bilangan-rasional/04-operasi-penjumlahan-pengurangan-pecahan" class="topik-link">Penjumlahan & Pengurangan Pecahan</a>
        <a href="/materi/bilangan/bilangan-rasional/05-operasi-perkalian-pembagian-pecahan" class="topik-link">Perkalian & Pembagian Pecahan</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Pangkat & Akar</h3>
      <div class="topik-grid">
        <a href="/materi/bilangan/pangkat-dan-akar/06-bilangan-berpangkat-bulat" class="topik-link">Bilangan Berpangkat Bulat</a>
        <a href="/materi/bilangan/pangkat-dan-akar/07-merasionalkan-bentuk-akar" class="topik-link">Merasionalkan Bentuk Akar</a>
        <a href="/materi/bilangan/pangkat-dan-akar/08-notasi-ilmiah" class="topik-link">Notasi Ilmiah</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Perbandingan</h3>
      <div class="topik-grid">
        <a href="/materi/bilangan/perbandingan/01-perbandingan-senilai" class="topik-link">Perbandingan Senilai</a>
        <a href="/materi/bilangan/perbandingan/02-perbandingan-berbalik-nilai" class="topik-link">Perbandingan Berbalik Nilai</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Himpunan</h3>
      <div class="topik-grid">
        <a href="/materi/bilangan/himpunan/01-mengenal-himpunan" class="topik-link">Mengenal Himpunan</a>
        <a href="/materi/bilangan/himpunan/02-operasi-himpunan" class="topik-link">Operasi Himpunan</a>
      </div>

      <h3 class="font-semibold text-lg mt-6 mb-3">Aritmetika Sosial</h3>
      <div class="topik-grid">
        <a href="/materi/bilangan/aritmetika-sosial/01-untung-rugi-dan-diskon" class="topik-link">Untung, Rugi & Diskon</a>
        <a href="/materi/bilangan/aritmetika-sosial/02-bunga-tunggal-dan-bruto-neto" class="topik-link">Bunga Tunggal, Bruto & Neto</a>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mt-12">
      <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
        <h3 class="font-bold text-xl mb-4 flex items-center gap-2">
          <span class="text-2xl">🌍</span> Mengapa Belajar Bilangan?
        </h3>
        <ul class="space-y-3 text-gray-700">
          <li class="flex gap-2">
            <span class="text-blue-500 font-bold">•</span>
            <span><strong>Perbankan:</strong> Menghitung bunga tabungan dan pinjaman.</span>
          </li>
          <li class="flex gap-2">
            <span class="text-blue-500 font-bold">•</span>
            <span><strong>Belanja Online:</strong> Mengkalkulasi diskon, cashback, dan harga bersih.</span>
          </li>
          <li class="flex gap-2">
            <span class="text-blue-500 font-bold">•</span>
            <span><strong>Ilmu Pengetahuan:</strong> Menggunakan notasi ilmiah untuk jarak antar planet atau ukuran bakteri.</span>
          </li>
        </ul>
      </div>

      <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
        <h3 class="font-bold text-xl mb-4 flex items-center gap-2 text-blue-800">
          <span class="text-2xl">🚀</span> Mulai dari Mana?
        </h3>
        <p class="mb-4 text-gray-700">Rekomendasi urutan belajar yang terstruktur:</p>
        <ol class="space-y-2 text-blue-900 font-medium">
          <li>1. Bilangan Bulat</li>
          <li>2. Bilangan Rasional</li>
          <li>3. Perbandingan</li>
          <li>4. Himpunan</li>
          <li>5. Pangkat & Akar</li>
          <li>6. Aritmetika Sosial</li>
        </ol>
      </div>
    </div>
  </div>
</Layout>

<style>
.elemen-header {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: white;
  padding: 3rem 2rem;
  border-radius: 16px;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  gap: 2rem;
}
.topik-section {
  margin-bottom: 2rem;
}
.topik-section h2 {
  font-size: 1.3rem;
  font-weight: 700;
  padding-bottom: 0.5rem;
  border-bottom: 3px solid #3b82f6;
  margin-bottom: 1rem;
}
.topik-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 0.75rem;
}
.topik-link {
  display: block;
  padding: 0.75rem 1rem;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  color: #1e293b;
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s;
  border-left: 4px solid #3b82f6;
}
.topik-link:hover {
  background: #eff6ff;
  border-color: #3b82f6;
  transform: translateX(4px);
}
@media (max-width: 768px) {
  .elemen-header {
    flex-direction: column;
    text-align: center;
    padding: 2rem 1.5rem;
  }
}
</style>
