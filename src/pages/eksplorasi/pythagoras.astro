<script>
// @ts-nocheck
window.verifikasiTabel = function() {
  const rows = document.querySelectorAll('.tabel-eksplorasi tbody tr');
  let semuaBenar = true;
  rows.forEach(row => {
    const a = parseInt(row.dataset.a);
    const b = parseInt(row.dataset.b);
    const c = parseInt(row.dataset.c);
    const inputs = row.querySelectorAll('input');
    const a2Input = parseInt(inputs[0].value);
    const b2Input = parseInt(inputs[1].value);
    const c2Input = parseInt(inputs[2].value);
    const statusCol = row.querySelector('.status-col');
    const benar = a2Input === a*a && b2Input === b*b && c2Input === c*c;
    statusCol.textContent = benar ? '✅' : '❌';
    statusCol.style.color = benar ? '#16a34a' : '#dc2626';
    if (!benar) semuaBenar = false;
  });
  const hasil = document.getElementById('hasil-verifikasi');
  hasil.style.display = 'block';
  if (semuaBenar) {
    hasil.innerHTML = '🎉 <strong>Semua benar!</strong> Kamu baru saja membuktikan Teorema Pythagoras secara mandiri! Pola yang kamu temukan: <strong>a² + b² = c²</strong>';
    hasil.className = 'verifikasi-result verifikasi-benar';
  } else {
    hasil.innerHTML = '❌ <strong>Ada yang belum tepat.</strong> Periksa kembali perhitunganmu. Ingat: a² berarti a × a.';
    hasil.className = 'verifikasi-result verifikasi-salah';
  }
}

document.querySelectorAll('input[name="pola"]').forEach(radio => {
  radio.addEventListener('change', function() {
    const feedback = document.getElementById('feedback-pola');
    feedback.style.display = 'block';
    if (this.value === 'benar') {
      feedback.innerHTML = '🌟 <strong>Hebat!</strong> Kamu baru saja menemukan Teorema Pythagoras secara mandiri!';
      feedback.className = 'feedback-pola-benar';
    } else {
      feedback.innerHTML = '🤔 <strong>Belum tepat.</strong> Perhatikan kolom a², b², dan c² pada tabelmu. Ada hubungan penjumlahan yang menarik!';
      feedback.className = 'feedback-pola-salah';
    }
  });
});

window.cekTantangan = function(id, jawabanBenar) {
  const input = document.getElementById(`jawaban-${id}`);
  const feedback = document.getElementById(`feedback-${id}`);
  const nilai = parseFloat(input.value);
  feedback.style.display = 'block';
  if (nilai === jawabanBenar) {
    feedback.innerHTML = '✅ <strong>Benar!</strong> Panjang tangga darurat adalah 5 meter.';
    feedback.className = 'feedback-benar';
  } else {
    feedback.innerHTML = `❌ <strong>Belum tepat.</strong> Coba lagi! Gunakan rumus c² = a² + b².`;
    feedback.className = 'feedback-salah';
  }
}

window.cekTantanganRange = function(id, min, max) {
  const input = document.getElementById(`jawaban-${id}`);
  const feedback = document.getElementById(`feedback-${id}`);
  const nilai = parseFloat(input.value);
  feedback.style.display = 'block';
  if (nilai >= min && nilai <= max) {
    feedback.innerHTML = '✅ <strong>Tepat!</strong> √13 ≈ 3.6 meter. Jadi petugas harus membeli minimal 4 meter kabel.';
    feedback.className = 'feedback-benar';
  } else {
    feedback.innerHTML = '❌ <strong>Belum tepat.</strong> Ingat: √13 berada di antara √9=3 dan √16=4. Coba nilai sekitar 3.6.';
    feedback.className = 'feedback-salah';
  }
}

window.pilihEmoji = function(btn) {
  const container = btn.closest('.emoji-skala');
  container.querySelectorAll('.emoji-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
}
</script>

