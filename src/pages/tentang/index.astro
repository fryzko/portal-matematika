---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Tentang" description="Tentang Portal Ruang Matematika SMP — pembelajaran matematika berbasis Kurikulum Merdeka.">


        <section class="hero-section">
            <div class="container">
                <h1>Tentang Portal</h1>
                <p class="hero-description">
                    Ruang Matematika SMP — belajar matematika dengan mudah, terstruktur, dan menyenangkan.
                </p>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <div class="section-heading">
                    <h2>Visi Portal</h2>
                </div>
                <div class="element-summary">
                    <p>
                        Portal Ruang Matematika SMP dirancang sebagai lingkungan belajar
                        mandiri untuk siswa SMP. Materi disusun secara hierarkis —
                        Kelas → Elemen → Topik → Materi — sesuai Kurikulum Merdeka Fase D.
                    </p>
                    <p>
                        Filosofi pembelajaran: <strong>Guru Mengajar</strong>,
                        <strong>Math Is Fun</strong>, dan <strong>Pembelajaran Mendalam</strong>.
                    </p>
                </div>
            </div>
        </section>

        <section class="section section-light">
            <div class="container">
                <div class="section-heading">
                    <h2>Struktur Pembelajaran</h2>
                </div>
                <div class="learning-path">
                    <p>Kelas</p>
                    <p>↓</p>
                    <p>Elemen</p>
                    <p>↓</p>
                    <p>Topik</p>
                    <p>↓</p>
                    <p>Materi</p>
                </div>
            </div>
        </section>

        <section class="section section-cta">
            <div class="container">
                <h2>Mulai Belajar</h2>
                <p>Jelajahi prototype akademik jalur Bilangan Bulat.</p>
                <div class="hero-actions">
                    <a href="/backups/old_static/pages/kelas/vii" class="button button-primary">Kelas VII</a>
                    <a href="/backups/old_static/pages/elemen/bilangan" class="button button-outline">Elemen Bilangan</a>
                </div>
            </div>
        </section>

    
</Layout>
