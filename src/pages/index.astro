---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ruang Matematika SMP">

    <section class="section section-light">
        <div class="container">
            <div class="section-heading">
                <h2>Struktur Pembelajaran SMP</h2>
                <p>Matematika SMP terdiri atas tiga tingkat kelas dan lima elemen utama pembelajaran.</p>
            </div>
            <div class="card-grid">
                <article class="card" style="display: flex; flex-direction: column;">
                    <h3>Kelas VII</h3>
                    <p style="flex-grow: 1;">Bilangan, Aljabar, Geometri, Pengukuran, dan Analisis Data.</p>
                    <a href="/kelas/vii" class="button button-primary" style="margin-top: 1rem; align-self: flex-start;">Lihat Kelas VII</a>
                </article>
                <article class="card" style="display: flex; flex-direction: column;">
                    <h3>Kelas VIII</h3>
                    <p style="flex-grow: 1;">Pengembangan konsep dan hubungan matematika yang lebih mendalam.</p>
                    <a href="/kelas/viii" class="button button-primary" style="margin-top: 1rem; align-self: flex-start;">Lihat Kelas VIII</a>
                </article>
                <article class="card" style="display: flex; flex-direction: column;">
                    <h3>Kelas IX</h3>
                    <p style="flex-grow: 1;">Penguatan konsep dan persiapan menuju jenjang berikutnya.</p>
                    <a href="/kelas/ix" class="button button-primary" style="margin-top: 1rem; align-self: flex-start;">Lihat Kelas IX</a>
                </article>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-heading">
                <h2>Fitur Pembelajaran</h2>
            </div>
            <div class="card-grid">
                <article class="card">
                    <h3>Materi</h3>
                    <p>Materi yang mudah dibaca dan terstruktur.</p>
                </article>
                <article class="card">
                    <h3>Latihan</h3>
                    <p>Latihan mandiri untuk memperkuat konsep.</p>
                </article>
                <article class="card">
                    <h3>Bank Soal</h3>
                    <p>Kumpulan soal untuk menguji kemampuan matematika.</p>
                </article>
                <article class="card">
                    <h3>Pencarian</h3>
                    <p>Menemukan materi secara cepat dan mudah.</p>
                </article>
            </div>
        </div>
    </section>

</Layout>
