---
// src/components/CoordinatePlane.astro
---

<coordinate-plane class="coordinate-widget">
  <div class="widget-header">
    <h3>Eksplorasi Bidang Kartesius & Pythagoras</h3>
    <p>Klik dua tempat berbeda pada grafik untuk membuat dua titik. Perhatikan bagaimana segitiga siku-siku terbentuk untuk menghitung jarak antara keduanya!</p>
  </div>

  <div class="plane-container">
    <div class="info-panel">
      <div class="point-info">
        <span class="point-dot dot-a">A</span>
        <span>Titik A: <strong id="coord-a">(?, ?)</strong></span>
      </div>
      <div class="point-info">
        <span class="point-dot dot-b">B</span>
        <span>Titik B: <strong id="coord-b">(?, ?)</strong></span>
      </div>
      
      <div class="calc-box" id="calc-box" style="display: none;">
        <h4>Kalkulasi Real-time</h4>
        <div class="pythagoras-formula">
          Titik A: (<span id="calc-ax">?</span>, <span id="calc-ay">?</span>)<br>
          Titik B: (<span id="calc-bx">?</span>, <span id="calc-by">?</span>)<br><br>
          &Delta;x = |x&sub2; - x&sub1;| = <span id="val-a">0</span><br>
          &Delta;y = |y&sub2; - y&sub1;| = <span id="val-b">0</span><br><br>
          Jarak AB = &radic;(&Delta;x&sup2; + &Delta;y&sup2;)<br>
          Jarak AB = &radic;(<span id="calc-a2">0</span> + <span id="calc-b2">0</span>)<br>
          Jarak AB = &radic;(<span id="calc-sum">0</span>) = <strong style="color: #2563eb;"><span id="calc-c">0</span></strong>
        </div>
      </div>
      <button id="btn-reset" class="btn-reset">Reset Bidang</button>
    </div>
    
    <div class="canvas-wrapper">
      <!-- 400x400 grid, from -10 to 10. Each step is 20px -->
      <svg id="plane-svg" class="plane-svg" viewBox="0 0 400 400" width="400" height="400">
        <!-- Grid lines will be injected by JS -->
        <g id="grid-group"></g>
        <!-- Axes -->
        <line x1="0" y1="200" x2="400" y2="200" class="axis-line" />
        <line x1="200" y1="0" x2="200" y2="400" class="axis-line" />
        <text x="385" y="215" class="axis-label">X</text>
        <text x="210" y="15" class="axis-label">Y</text>
        
        <!-- Dynamic Drawing -->
        <g id="drawing-group">
          <!-- Triangle Lines -->
          <line id="line-x" class="triangle-line line-x" x1="0" y1="0" x2="0" y2="0" opacity="0" />
          <line id="line-y" class="triangle-line line-y" x1="0" y1="0" x2="0" y2="0" opacity="0" />
          <line id="line-c" class="triangle-line line-c" x1="0" y1="0" x2="0" y2="0" opacity="0" />
          
          <!-- Distance Labels -->
          <rect id="bg-a" class="label-bg" width="24" height="20" rx="4" opacity="0" />
          <text id="label-a" class="dist-label" opacity="0">a</text>
          
          <rect id="bg-b" class="label-bg" width="24" height="20" rx="4" opacity="0" />
          <text id="label-b" class="dist-label" opacity="0">b</text>

          <rect id="bg-c" class="label-bg label-bg-c" width="40" height="20" rx="4" opacity="0" />
          <text id="label-c" class="dist-label text-c" opacity="0">c</text>

          <!-- Points -->
          <circle id="pt-a" class="point pt-a" cx="-100" cy="-100" r="6" />
          <text id="txt-a" class="point-label" x="-100" y="-100">A</text>
          
          <circle id="pt-b" class="point pt-b" cx="-100" cy="-100" r="6" />
          <text id="txt-b" class="point-label" x="-100" y="-100">B</text>
        </g>
      </svg>
    </div>
  </div>
</coordinate-plane>

<script>
// @ts-nocheck
  class CoordinatePlane extends HTMLElement {
    constructor() {
      super();
      this.state = {
        pointA: null, // {x, y} in grid coordinates (-10 to 10)
        pointB: null
      };

      this.config = {
        gridMin: -10,
        gridMax: 10,
        svgSize: 400,
        step: 20 // 400 / 20 = 20px per unit
      };

      this.els = {
        svg: this.querySelector('#plane-svg'),
        gridGroup: this.querySelector('#grid-group'),
        coordA: this.querySelector('#coord-a'),
        coordB: this.querySelector('#coord-b'),
        calcBox: this.querySelector('#calc-box'),
        btnReset: this.querySelector('#btn-reset'),
        // Draw elements
        ptA: this.querySelector('#pt-a'), txtA: this.querySelector('#txt-a'),
        ptB: this.querySelector('#pt-b'), txtB: this.querySelector('#txt-b'),
        lineX: this.querySelector('#line-x'), lineY: this.querySelector('#line-y'), lineC: this.querySelector('#line-c'),
        labelA: this.querySelector('#label-a'), bgA: this.querySelector('#bg-a'),
        labelB: this.querySelector('#label-b'), bgB: this.querySelector('#bg-b'),
        labelC: this.querySelector('#label-c'), bgC: this.querySelector('#bg-c'),
        // Calc elements
        valA: this.querySelector('#val-a'), valB: this.querySelector('#val-b'),
        calcA2: this.querySelector('#calc-a2'), calcB2: this.querySelector('#calc-b2'),
        calcSum: this.querySelector('#calc-sum'), calcC: this.querySelector('#calc-c'),
        calcAx: this.querySelector('#calc-ax'), calcAy: this.querySelector('#calc-ay'),
        calcBx: this.querySelector('#calc-bx'), calcBy: this.querySelector('#calc-by')
      };

      this.initGrid();
      
      this.els.svg.addEventListener('click', (e) => this.handleSvgClick(e));
      this.els.btnReset.addEventListener('click', () => this.resetPlane());
    }

    initGrid() {
      // Draw grid lines
      let gridHtml = '';
      for(let i = this.config.gridMin; i <= this.config.gridMax; i++) {
        const pos = this.gridToPx(i, 0).x;
        // Vertical lines
        gridHtml += `<line x1="${pos}" y1="0" x2="${pos}" y2="${this.config.svgSize}" class="grid-line" />`;
        // Horizontal lines (y is inverted)
        gridHtml += `<line x1="0" y1="${pos}" x2="${this.config.svgSize}" y2="${pos}" class="grid-line" />`;
        
        // Number labels for X axis
        if(i !== 0 && i % 2 === 0) {
          gridHtml += `<text x="${pos}" y="${this.config.svgSize/2 + 15}" class="grid-label text-center">${i}</text>`;
          gridHtml += `<text x="${this.config.svgSize/2 - 15}" y="${pos + 4}" class="grid-label text-right">${-i}</text>`;
        }
      }
      this.els.gridGroup.innerHTML = gridHtml;
    }

    // Convert grid coordinate (e.g. x=3, y=-4) to SVG pixel coordinate
    gridToPx(gx, gy) {
      return {
        x: (gx - this.config.gridMin) * this.config.step,
        y: this.config.svgSize - ((gy - this.config.gridMin) * this.config.step)
      };
    }

    // Convert SVG pixel coordinate to nearest grid coordinate
    pxToGrid(px, py) {
      // Get SVG bounds to calculate exact click position relative to viewBox
      const rect = this.els.svg.getBoundingClientRect();
      const scaleX = this.config.svgSize / rect.width;
      const scaleY = this.config.svgSize / rect.height;
      
      const svgX = (px - rect.left) * scaleX;
      const svgY = (py - rect.top) * scaleY;
      
      // Snap to nearest grid point
      const gx = Math.round(svgX / this.config.step) + this.config.gridMin;
      const gy = this.config.gridMax - Math.round(svgY / this.config.step);
      
      // Clamp
      return {
        x: Math.max(this.config.gridMin, Math.min(this.config.gridMax, gx)),
        y: Math.max(this.config.gridMin, Math.min(this.config.gridMax, gy))
      };
    }

    handleSvgClick(e) {
      const gridPos = this.pxToGrid(e.clientX, e.clientY);
      
      if (!this.state.pointA) {
        this.state.pointA = gridPos;
        this.updateDisplay();
      } else if (!this.state.pointB) {
        // Prevent clicking same point
        if (gridPos.x !== this.state.pointA.x || gridPos.y !== this.state.pointA.y) {
          this.state.pointB = gridPos;
          this.updateDisplay();
        }
      }
    }

    resetPlane() {
      this.state.pointA = null;
      this.state.pointB = null;
      this.updateDisplay();
    }

    setPoint(ptEl, txtEl, gridPos, label) {
      if (!gridPos) {
        ptEl.setAttribute('cx', -100);
        ptEl.setAttribute('cy', -100);
        txtEl.setAttribute('x', -100);
        txtEl.setAttribute('y', -100);
        return;
      }
      const px = this.gridToPx(gridPos.x, gridPos.y);
      ptEl.setAttribute('cx', px.x);
      ptEl.setAttribute('cy', px.y);
      txtEl.setAttribute('x', px.x + 8);
      txtEl.setAttribute('y', px.y - 8);
      txtEl.textContent = label;
    }

    setLine(lineEl, px1, py1, px2, py2, opacity) {
      lineEl.setAttribute('x1', px1);
      lineEl.setAttribute('y1', py1);
      lineEl.setAttribute('x2', px2);
      lineEl.setAttribute('y2', py2);
      lineEl.setAttribute('opacity', opacity);
    }
    
    setLabelCenter(labelEl, bgEl, px1, py1, px2, py2, text, opacity) {
      const cx = (px1 + px2) / 2;
      const cy = (py1 + py2) / 2;
      labelEl.setAttribute('x', cx);
      labelEl.setAttribute('y', cy + 4); // manual vertical alignment
      labelEl.textContent = text;
      labelEl.setAttribute('opacity', opacity);
      
      // Background rect (assumes fixed width 24/40, height 20)
      const w = parseInt(bgEl.getAttribute('width'));
      bgEl.setAttribute('x', cx - (w/2));
      bgEl.setAttribute('y', cy - 10);
      bgEl.setAttribute('opacity', opacity);
    }

    updateDisplay() {
      // Update text coords
      this.els.coordA.textContent = this.state.pointA ? `(${this.state.pointA.x}, ${this.state.pointA.y})` : '(?, ?)';
      this.els.coordB.textContent = this.state.pointB ? `(${this.state.pointB.x}, ${this.state.pointB.y})` : '(?, ?)';

      // Draw points
      this.setPoint(this.els.ptA, this.els.txtA, this.state.pointA, 'A');
      this.setPoint(this.els.ptB, this.els.txtB, this.state.pointB, 'B');

      if (this.state.pointA && this.state.pointB) {
        // Draw Triangle
        const pxA = this.gridToPx(this.state.pointA.x, this.state.pointA.y);
        const pxB = this.gridToPx(this.state.pointB.x, this.state.pointB.y);
        
        // Find corner point C for right triangle
        // We can either go horizontal first then vertical, or vice versa.
        // Let's use (pointB.x, pointA.y) as corner.
        const pxCorner = this.gridToPx(this.state.pointB.x, this.state.pointA.y);
        
        this.setLine(this.els.lineX, pxA.x, pxA.y, pxCorner.x, pxCorner.y, 1);
        this.setLine(this.els.lineY, pxCorner.x, pxCorner.y, pxB.x, pxB.y, 1);
        this.setLine(this.els.lineC, pxA.x, pxA.y, pxB.x, pxB.y, 1);

        // Distances
        const distA = Math.abs(this.state.pointB.x - this.state.pointA.x);
        const distB = Math.abs(this.state.pointB.y - this.state.pointA.y);
        const distC = Math.sqrt(distA*distA + distB*distB).toFixed(2);
        
        // Labels on canvas
        this.setLabelCenter(this.els.labelA, this.els.bgA, pxA.x, pxA.y, pxCorner.x, pxCorner.y, distA, 1);
        this.setLabelCenter(this.els.labelB, this.els.bgB, pxCorner.x, pxCorner.y, pxB.x, pxB.y, distB, 1);
        
        // offset hypotenuse label slightly
        this.setLabelCenter(this.els.labelC, this.els.bgC, pxA.x, pxA.y, pxB.x, pxB.y, distC, 1);

        // Calculation Box
        this.els.calcBox.style.display = 'block';
        this.els.calcAx.textContent = this.state.pointA.x;
        this.els.calcAy.textContent = this.state.pointA.y;
        this.els.calcBx.textContent = this.state.pointB.x;
        this.els.calcBy.textContent = this.state.pointB.y;
        
        this.els.valA.textContent = distA;
        this.els.valB.textContent = distB;
        this.els.calcA2.textContent = distA*distA;
        this.els.calcB2.textContent = distB*distB;
        this.els.calcSum.textContent = distA*distA + distB*distB;
        this.els.calcC.textContent = distC;

      } else {
        // Hide lines and calc
        this.setLine(this.els.lineX, 0,0,0,0, 0);
        this.setLine(this.els.lineY, 0,0,0,0, 0);
        this.setLine(this.els.lineC, 0,0,0,0, 0);
        this.els.labelA.setAttribute('opacity', 0); this.els.bgA.setAttribute('opacity', 0);
        this.els.labelB.setAttribute('opacity', 0); this.els.bgB.setAttribute('opacity', 0);
        this.els.labelC.setAttribute('opacity', 0); this.els.bgC.setAttribute('opacity', 0);
        this.els.calcBox.style.display = 'none';
      }
    }
  }

  customElements.define('coordinate-plane', CoordinatePlane);
</script>

<style>
  .coordinate-widget {
    display: block;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 2rem;
    margin: 2rem 0;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .widget-header { text-align: center; margin-bottom: 2rem; }
  .widget-header h3 { margin-top: 0; color: #1e293b; }

  .plane-container {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
  }
  .canvas-wrapper {
    background: white;
    padding: 10px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  .plane-svg {
    background: #fdfdfd;
    cursor: crosshair;
    user-select: none;
  }
  
  /* SVG Styles */
  .grid-line { stroke: #e2e8f0; stroke-width: 1; }
  .axis-line { stroke: #475569; stroke-width: 2; }
  .axis-label { fill: #475569; font-weight: bold; font-size: 14px; }
  .grid-label { fill: #94a3b8; font-size: 10px; }
  .text-center { text-anchor: middle; }
  .text-right { text-anchor: end; }
  
  .point { fill: #ef4444; stroke: white; stroke-width: 2; transition: all 0.3s; }
  .pt-a { fill: #3b82f6; }
  .point-label { font-weight: bold; font-size: 14px; fill: #1e293b; pointer-events: none; }
  
  .triangle-line { stroke-width: 3; stroke-dasharray: 6 4; transition: opacity 0.3s; }
  .line-x { stroke: #3b82f6; }
  .line-y { stroke: #f59e0b; }
  .line-c { stroke: #ef4444; stroke-dasharray: none; }

  .label-bg { fill: white; stroke: #cbd5e1; stroke-width: 1; pointer-events: none; }
  .label-bg-c { stroke: #fca5a5; }
  .dist-label { font-size: 12px; font-weight: bold; text-anchor: middle; fill: #475569; pointer-events: none; }
  .text-c { fill: #ef4444; }

  /* Info Panel */
  .info-panel {
    flex: 1;
    min-width: 250px;
    max-width: 350px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .point-info {
    background: white;
    border: 1px solid #e2e8f0;
    padding: 1rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.1rem;
  }
  .point-dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.9rem;
  }
  .dot-a { background: #3b82f6; }
  .dot-b { background: #ef4444; }

  .calc-box {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 1.5rem;
    border-radius: 8px;
  }
  .calc-box h4 { margin-top: 0; color: #166534; margin-bottom: 1rem; }
  .pythagoras-formula {
    background: white;
    padding: 1rem;
    border-radius: 6px;
    margin-top: 1rem;
    font-family: monospace;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #374151;
  }
  
  .btn-reset {
    background: #64748b;
    color: white;
    border: none;
    padding: 0.8rem;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-reset:hover { background: #475569; }
</style>
