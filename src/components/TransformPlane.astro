---
interface Props {
  mode: "translasi" | "refleksi" | "rotasi" | "dilatasi";
  instruction: string;
}
const { mode, instruction } = Astro.props;
---

<transform-plane class="coordinate-widget" data-mode={mode}>
  <div class="widget-header">
    <h3>Eksplorasi {mode.charAt(0).toUpperCase() + mode.slice(1)}</h3>
    <p>{instruction}</p>
  </div>

  <div class="plane-container">
    <div class="info-panel">
      <div class="point-info">
        <span class="point-dot dot-a">A</span>
        <span>Titik Asal: <strong id="coord-a">(2, 3)</strong></span>
      </div>
      
      <div class="controls-box">
        {mode === 'translasi' && (
          <div class="control-group">
            <label>Vektor Translasi (a, b):</label>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
              (<input type="number" id="input-tx" value="3" style="width:50px" />, <input type="number" id="input-ty" value="2" style="width:50px" />)
            </div>
          </div>
        )}
        
        {mode === 'refleksi' && (
          <div class="control-group">
            <label>Sumbu Cermin:</label>
            <select id="input-refleksi">
              <option value="x">Sumbu x</option>
              <option value="y">Sumbu y</option>
              <option value="yx">Garis y = x</option>
              <option value="y-x">Garis y = -x</option>
            </select>
          </div>
        )}

        {mode === 'rotasi' && (
          <div class="control-group">
            <label>Sudut Rotasi (pusat 0,0):</label>
            <select id="input-rotasi">
              <option value="90">90° (Berlawanan jarum jam)</option>
              <option value="180">180° (Setengah putaran)</option>
              <option value="270">270° / -90°</option>
            </select>
          </div>
        )}

        {mode === 'dilatasi' && (
          <div class="control-group">
            <label>Faktor Skala (k):</label>
            <input type="number" id="input-dilatasi" value="2" step="0.5" style="width:80px" />
          </div>
        )}

        <button id="btn-transform" class="btn-action" style="margin-top: 1rem; width: 100%;">Terapkan Transformasi</button>
      </div>

      <div class="result-box" id="result-box" style="display: none; margin-top: 1rem;">
        <div class="point-info" style="border-color: #f59e0b; background: #fffbeb; margin-bottom: 0.5rem;">
          <span class="point-dot dot-a-prime" style="background: #f59e0b;">A'</span>
          <span>Titik Hasil: <strong id="coord-aprime">(?, ?)</strong></span>
        </div>
        <div id="calc-process" style="background: #f0fdf4; padding: 0.75rem; border-radius: 6px; border: 1px solid #bbf7d0; font-family: monospace; font-size: 0.95rem; color: #166534; text-align: center;">
          <!-- Kalkulasi -->
        </div>
      </div>
    </div>
    
    <div class="canvas-wrapper">
      <svg id="plane-svg" class="plane-svg" viewBox="0 0 400 400" width="400" height="400">
        <g id="grid-group"></g>
        <line x1="0" y1="200" x2="400" y2="200" class="axis-line" />
        <line x1="200" y1="0" x2="200" y2="400" class="axis-line" />
        <text x="385" y="215" class="axis-label">X</text>
        <text x="210" y="15" class="axis-label">Y</text>
        
        <g id="drawing-group">
          <!-- Mirror line for refleksi -->
          <line id="mirror-line" stroke="#10b981" stroke-width="2" stroke-dasharray="5 5" opacity="0" x1="0" y1="0" x2="0" y2="0" />
          
          <line id="conn-line" stroke="#94a3b8" stroke-width="2" stroke-dasharray="4 4" opacity="0" x1="0" y1="0" x2="0" y2="0" />
          
          <circle id="pt-a" class="point pt-a" cx="-100" cy="-100" r="6" />
          <text id="txt-a" class="point-label" x="-100" y="-100">A</text>
          
          <circle id="pt-aprime" class="point pt-aprime" cx="-100" cy="-100" r="6" fill="#f59e0b" opacity="0" />
          <text id="txt-aprime" class="point-label" x="-100" y="-100" opacity="0">A'</text>
        </g>
      </svg>
    </div>
  </div>
</transform-plane>

<script>
// @ts-nocheck
  class TransformPlane extends HTMLElement {
    constructor() {
      super();
      this.mode = this.getAttribute('data-mode');
      
      this.config = {
        gridMin: -10,
        gridMax: 10,
        svgSize: 400,
        step: 20
      };

      this.state = {
        ptA: {x: 2, y: 3},
        ptAPrime: null
      };

      this.els = {
        gridGroup: this.querySelector('#grid-group'),
        btnTransform: this.querySelector('#btn-transform'),
        resultBox: this.querySelector('#result-box'),
        coordAPrime: this.querySelector('#coord-aprime'),
        ptA: this.querySelector('#pt-a'),
        txtA: this.querySelector('#txt-a'),
        ptAPrime: this.querySelector('#pt-aprime'),
        txtAPrime: this.querySelector('#txt-aprime'),
        connLine: this.querySelector('#conn-line'),
        mirrorLine: this.querySelector('#mirror-line'),
        calcProcess: this.querySelector('#calc-process')
      };

      this.initGrid();
      this.updateDisplay();
      
      if (this.els.btnTransform) {
        this.els.btnTransform.addEventListener('click', () => this.applyTransform());
      }
    }

    initGrid() {
      let gridHtml = '';
      for(let i = this.config.gridMin; i <= this.config.gridMax; i++) {
        const pos = this.gridToPx(i, 0).x;
        gridHtml += `<line x1="${pos}" y1="0" x2="${pos}" y2="${this.config.svgSize}" class="grid-line" />`;
        gridHtml += `<line x1="0" y1="${pos}" x2="${this.config.svgSize}" y2="${pos}" class="grid-line" />`;
        if(i !== 0 && i % 2 === 0) {
          gridHtml += `<text x="${pos}" y="${this.config.svgSize/2 + 15}" class="grid-label text-center">${i}</text>`;
          gridHtml += `<text x="${this.config.svgSize/2 - 15}" y="${pos + 4}" class="grid-label text-right">${-i}</text>`;
        }
      }
      this.els.gridGroup.innerHTML = gridHtml;
    }

    gridToPx(gx, gy) {
      return {
        x: (gx - this.config.gridMin) * this.config.step,
        y: this.config.svgSize - ((gy - this.config.gridMin) * this.config.step)
      };
    }
    
    setPoint(ptEl, txtEl, gridPos, label, opacity = 1) {
      if (!gridPos) {
        ptEl.setAttribute('opacity', 0);
        txtEl.setAttribute('opacity', 0);
        return;
      }
      const px = this.gridToPx(gridPos.x, gridPos.y);
      ptEl.setAttribute('cx', px.x);
      ptEl.setAttribute('cy', px.y);
      ptEl.setAttribute('opacity', opacity);
      
      txtEl.setAttribute('x', px.x + 8);
      txtEl.setAttribute('y', px.y - 8);
      txtEl.textContent = label;
      txtEl.setAttribute('opacity', opacity);
    }

    applyTransform() {
      let nx, ny;
      let calcText = "";
      let {x, y} = this.state.ptA;
      
      this.els.mirrorLine.setAttribute('opacity', 0);
      
      if (this.mode === 'translasi') {
        const tx = parseFloat(this.querySelector('#input-tx').value) || 0;
        const ty = parseFloat(this.querySelector('#input-ty').value) || 0;
        nx = x + tx;
        ny = y + ty;
        calcText = `A(${x},${y}) + vektor(${tx},${ty}) &rarr; A'(${nx}, ${ny})`;
      } else if (this.mode === 'refleksi') {
        const ref = this.querySelector('#input-refleksi').value;
        if (ref === 'x') {
          nx = x; ny = -y;
          this.drawMirrorLine(-10, 0, 10, 0);
        } else if (ref === 'y') {
          nx = -x; ny = y;
          this.drawMirrorLine(0, -10, 0, 10);
        } else if (ref === 'yx') {
          nx = y; ny = x;
          this.drawMirrorLine(-10, -10, 10, 10);
        } else if (ref === 'y-x') {
          nx = -y; ny = -x;
          this.drawMirrorLine(-10, 10, 10, -10);
        }
        
        const selRef = this.querySelector('#input-refleksi');
        const refName = selRef.options[selRef.selectedIndex].text;
        calcText = `A(${x},${y}) direfleksikan thd ${refName} &rarr; A'(${nx}, ${ny})`;
      } else if (this.mode === 'rotasi') {
        const rot = this.querySelector('#input-rotasi').value;
        if (rot === '90') {
          nx = -y; ny = x;
        } else if (rot === '180') {
          nx = -x; ny = -y;
        } else if (rot === '270') {
          nx = y; ny = -x;
        }
        calcText = `A(${x},${y}) dirotasi ${rot}&deg; &rarr; A'(${nx}, ${ny})`;
      } else if (this.mode === 'dilatasi') {
        const k = parseFloat(this.querySelector('#input-dilatasi').value) || 1;
        nx = x * k;
        ny = y * k;
        
        // line from origin
        const pxO = this.gridToPx(0, 0);
        const pxA = this.gridToPx(nx, ny);
        this.els.mirrorLine.setAttribute('x1', pxO.x);
        this.els.mirrorLine.setAttribute('y1', pxO.y);
        this.els.mirrorLine.setAttribute('x2', pxA.x);
        this.els.mirrorLine.setAttribute('y2', pxA.y);
        this.els.mirrorLine.setAttribute('stroke', '#cbd5e1');
        this.els.mirrorLine.setAttribute('opacity', 1);
        
        calcText = `A(${x},${y}) &times; k=${k} &rarr; A'(${nx}, ${ny})`;
      }
      
      this.els.calcProcess.innerHTML = calcText;
      
      this.state.ptAPrime = {x: nx, y: ny};
      this.updateDisplay();
    }
    
    drawMirrorLine(x1, y1, x2, y2) {
      const p1 = this.gridToPx(x1, y1);
      const p2 = this.gridToPx(x2, y2);
      this.els.mirrorLine.setAttribute('x1', p1.x);
      this.els.mirrorLine.setAttribute('y1', p1.y);
      this.els.mirrorLine.setAttribute('x2', p2.x);
      this.els.mirrorLine.setAttribute('y2', p2.y);
      this.els.mirrorLine.setAttribute('stroke', '#10b981');
      this.els.mirrorLine.setAttribute('opacity', 1);
    }

    updateDisplay() {
      this.setPoint(this.els.ptA, this.els.txtA, this.state.ptA, 'A', 1);
      
      if (this.state.ptAPrime) {
        this.setPoint(this.els.ptAPrime, this.els.txtAPrime, this.state.ptAPrime, "A'", 1);
        this.els.resultBox.style.display = 'block';
        
        // format nicely if decimal
        const fx = Number.isInteger(this.state.ptAPrime.x) ? this.state.ptAPrime.x : this.state.ptAPrime.x.toFixed(1);
        const fy = Number.isInteger(this.state.ptAPrime.y) ? this.state.ptAPrime.y : this.state.ptAPrime.y.toFixed(1);
        this.els.coordAPrime.textContent = `(${fx}, ${fy})`;
        
        const p1 = this.gridToPx(this.state.ptA.x, this.state.ptA.y);
        const p2 = this.gridToPx(this.state.ptAPrime.x, this.state.ptAPrime.y);
        this.els.connLine.setAttribute('x1', p1.x);
        this.els.connLine.setAttribute('y1', p1.y);
        this.els.connLine.setAttribute('x2', p2.x);
        this.els.connLine.setAttribute('y2', p2.y);
        this.els.connLine.setAttribute('opacity', 1);
      }
    }
  }

  customElements.define('transform-plane', TransformPlane);
</script>

<style>
  .coordinate-widget {
    display: block;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 2rem;
    margin: 2rem 0;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .widget-header { text-align: center; margin-bottom: 2rem; }
  .widget-header h3 { margin-top: 0; color: #1e293b; }

  .plane-container {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
  }
  .canvas-wrapper {
    background: white;
    padding: 10px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  .plane-svg {
    background: #fdfdfd;
    user-select: none;
  }
  
  .grid-line { stroke: #e2e8f0; stroke-width: 1; }
  .axis-line { stroke: #475569; stroke-width: 2; }
  .axis-label { fill: #475569; font-weight: bold; font-size: 14px; }
  .grid-label { fill: #94a3b8; font-size: 10px; }
  .text-center { text-anchor: middle; }
  .text-right { text-anchor: end; }
  
  .point { stroke: white; stroke-width: 2; transition: all 0.3s; }
  .pt-a { fill: #3b82f6; }
  .point-label { font-weight: bold; font-size: 14px; fill: #1e293b; pointer-events: none; }
  
  .info-panel {
    flex: 1;
    min-width: 250px;
    max-width: 350px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .point-info {
    background: white;
    border: 1px solid #e2e8f0;
    padding: 1rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.1rem;
  }
  .point-dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.9rem;
  }
  .dot-a { background: #3b82f6; }

  .controls-box {
    background: white;
    border: 1px solid #e2e8f0;
    padding: 1.5rem;
    border-radius: 8px;
  }
  .control-group {
    margin-bottom: 1rem;
  }
  .control-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: #334155;
  }
  .control-group input, .control-group select {
    padding: 0.5rem;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    font-size: 1rem;
  }
  
  .btn-action {
    background: #3b82f6;
    color: white;
    border: none;
    padding: 0.8rem;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-action:hover { background: #2563eb; }
</style>
