---
import Analytics from '@vercel/analytics/astro';
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Portal pembelajaran matematika SMP yang terstruktur, mudah dipahami, dan mendukung pembelajaran mandiri sesuai Kurikulum Merdeka." } = Astro.props;

// Mengimpor stylesheet utama agar Vite dapat memproses dan mengompresinya saat proses build
import '../../assets/css/main.css';

const currentPath = Astro.url.pathname;
function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <!-- KaTeX CSS for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <!-- Fallback untuk menyembunyikan mathml jika CSS gagal dimuat -->
    <style is:global>
        .katex-mathml {
            display: none !important;
        }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a href="/" class="site-logo">Ruang Matematika SMP</a>
            <nav class="main-navigation" aria-label="Navigasi Utama">
                <ul class="navigation-list">
                    <li><a href="/" class={isActive('/') ? 'active' : ''}>Beranda</a></li>
                    <li><a href="/kelas" class={isActive('/kelas') ? 'active' : ''}>Kelas</a></li>
                    <li><a href="/elemen" class={isActive('/elemen') ? 'active' : ''}>Elemen</a></li>
                    <li><a href="/latihan" class={isActive('/latihan') ? 'active' : ''}>Latihan</a></li>
                    <li><a href="/bank-soal" class={isActive('/bank-soal') ? 'active' : ''}>Bank Soal</a></li>
                    <li><a href="#">Peta Belajar</a></li>
                    <li>
                        <div class="nav-search">
                          <button class="search-toggle" onclick="document.getElementById('nav-search-input').focus()" aria-label="Cari materi">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="11" cy="11" r="8"/>
                              <path d="m21 21-4.35-4.35"/>
                            </svg>
                          </button>
                          <input
                            type="text"
                            class="search-input"
                            id="nav-search-input"
                            placeholder="Cari materi..."
                            onkeydown="if(event.key==='Enter' && this.value.trim()) window.location.href='/search?q='+encodeURIComponent(this.value.trim())"
                          >
                        </div>
                    </li>
                    <li><a href="/tentang" class={isActive('/tentang') ? 'active' : ''}>Tentang</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main data-pagefind-body>
        <slot />
    </main>

    <footer>
      <div class="footer-content">
        <!-- Kolom kiri: info portal -->
        <div class="footer-brand">
          <h3>Ruang Matematika SMP</h3>
          <p>Portal pembelajaran matematika yang membantu siswa memahami konsep secara bertahap melalui materi, latihan, dan bank soal yang disusun sesuai Kurikulum Merdeka.</p>
        </div>

        <!-- Kolom kanan: navigasi grid 2x3 -->
        <div class="footer-nav">
          <h4>Navigasi</h4>
          <div class="footer-nav-grid">
            <a href="/">Beranda</a>
            <a href="/kelas">Kelas</a>
            <a href="/elemen">Elemen</a>
            <a href="/latihan">Latihan</a>
            <a href="/bank-soal">Bank Soal</a>
            <a href="/tentang">Tentang</a>
          </div>
        </div>

        <!-- Kolom ketiga: Hubungi Kami -->
        <div class="footer-contact">
          <h4>Hubungi Kami</h4>
          <p style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 1rem;">
            Butuh bantuan? Hubungi pengembang:
          </p>
          <div class="social-links">
            <a href="https://wa.me/6285150753346" target="_blank" class="social-btn social-wa">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp
            </a>
            <a href="https://www.facebook.com/stanislaus.depa.2025?locale=id_ID" target="_blank" class="social-btn social-fb">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              Facebook
            </a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© 2026 Ruang Matematika SMP • Versi 1.0</p>
        <p>Disusun berdasarkan Kurikulum Merdeka Fase D</p>
      </div>
    </footer>

    <style>
      /* Search Navbar */
      .nav-search {
        display: flex;
        align-items: center;
        background: #f1f5f9;
        border: 1.5px solid #e2e8f0;
        border-radius: 24px;
        padding: 0.3rem 0.75rem;
        gap: 0.5rem;
        transition: border-color 0.2s;
      }
      .nav-search:focus-within {
        border-color: #6366f1;
        background: white;
      }
      .search-toggle {
        background: none;
        border: none;
        cursor: pointer;
        color: #64748b;
        display: flex;
        align-items: center;
        padding: 0;
      }
      .search-input {
        border: none;
        background: none;
        outline: none;
        font-size: 0.85rem;
        color: #1e293b;
        width: 140px;
        cursor: pointer;
      }
      .search-input::placeholder { color: #94a3b8; }

      /* Semua link navbar */
      nav a {
        color: #475569;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        transition: background 0.2s, color 0.2s;
      }
      nav a:hover {
        background: #f1f5f9;
        color: #1e293b;
      }
      nav a.active {
        background: #e0e7ff;
        color: #4338ca;
        font-weight: 600;
      }

      /* Footer Contacts */
      .footer-contact h4 {
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 1rem;
      }
      .social-links {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .social-btn {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: opacity 0.2s, transform 0.2s;
      }
      .social-btn:hover { opacity: 0.9; transform: translateX(4px); }
      .social-wa {
        background: #25d366;
        color: white;
      }
      .social-fb {
        background: #1877f2;
        color: white;
      }

      footer {
        background: #1e293b;
        color: #e2e8f0;
        padding: 3rem 2rem 1.5rem;
        margin-top: 4rem;
      }
      .footer-content {
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        gap: 3rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid #334155;
      }
      .footer-brand h3 {
        color: #ffffff;
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
      }
      .footer-brand p {
        color: #94a3b8;
        font-size: 0.9rem;
        line-height: 1.7;
      }
      .footer-nav h4 {
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 1rem;
      }
      .footer-nav-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem 1rem;
      }
      .footer-nav-grid a {
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s;
        padding: 0.25rem 0;
        border-bottom: 1px solid transparent;
      }
      .footer-nav-grid a:hover {
        color: #ffffff;
        border-bottom-color: #6366f1;
      }
      .footer-bottom {
        max-width: 1100px;
        margin: 1.5rem auto 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .footer-bottom p {
        color: #64748b;
        font-size: 0.8rem;
      }
      @media (max-width: 768px) {
        .footer-content { grid-template-columns: 1fr; gap: 2rem; }
        .footer-nav-grid { grid-template-columns: repeat(2, 1fr); }
        .footer-bottom { flex-direction: column; text-align: center; }
      }
    </style>

    <script>
        import '../../assets/js/main.js';
    </script>
      <!-- Komponen Pelacak Pengunjung Vercel Web Analytics -->
    <Analytics />
</body>
</html>
