<file path="assets/js/components/search.js">
/**
 * Search — Portal Ruang Matematika SMP
 */

const SEARCH_INDEX_PATH = "data/search-index.json";

export function initSearch() {
    const forms = document.querySelectorAll("[data-search-form]");

    forms.forEach((form) => {
        form.addEventListener("submit", handleSearchSubmit);
    });

    prefillSearchFromQuery();
}

async function prefillSearchFromQuery() {
    const params = new URLSearchParams(window.location.search);
    const query = params.get("q");

    if (!query) {
        return;
    }

    const form = document.querySelector("[data-search-form]");
    const input = form?.querySelector('input[type="search"]');

    if (input && form) {
        input.value = query;
        await handleSearchSubmit({
            preventDefault() {},
            currentTarget: form,
        });
    }
}

async function handleSearchSubmit(event) {
    event.preventDefault();

    const form = event.currentTarget;
    const input = form.querySelector('input[type="search"]');
    const resultsContainer = document.querySelector(form.dataset.resultsTarget || "#search-results");

    if (!input || !resultsContainer) {
        return;
    }

    const query = input.value.trim().toLowerCase();

    if (!query) {
        resultsContainer.innerHTML = "";
        return;
    }

    const index = await loadSearchIndex();
    const rootPrefix = getRootPrefix();
    const results = index.filter((item) => {
        return (
            item.title.toLowerCase().includes(query) ||
            item.description.toLowerCase().includes(query) ||
            item.keywords.some((keyword) => keyword.includes(query))
        );
    });

    renderResults(resultsContainer, results, query, rootPrefix);
}

async function loadSearchIndex() {
    try {
        const response = await fetch(`${getRootPrefix()}${SEARCH_INDEX_PATH}`);

        if (!response.ok) {
            throw new Error("Index tidak ditemukan");
        }

        return await response.json();
    } catch {
        return [];
    }
}

function getRootPrefix() {
    const cssLink = document.querySelector('link[href*="main.css"]');

    if (!cssLink) {
        return "./";
    }

    const href = cssLink.getAttribute("href") || "";
    const match = href.match(/^((?:\.\.\/)*)(?=assets\/)/);

    return match ? match[1] : "./";
}

function renderResults(container, results, query, rootPrefix) {
    if (results.length === 0) {
        container.innerHTML = `
            <p>Tidak ditemukan materi untuk "<strong>${escapeHtml(query)}</strong>".</p>
        `;
        return;
    }

    container.innerHTML = results
        .map(
            (item) => `
            <article class="search-result-item">
                <a href="${escapeHtml(`${rootPrefix}${item.url}`)}">${escapeHtml(item.title)}</a>
                <p>${escapeHtml(item.description)}</p>
            </article>
        `
        )
        .join("");
}

function escapeHtml(value) {
    return value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
}
</file>

